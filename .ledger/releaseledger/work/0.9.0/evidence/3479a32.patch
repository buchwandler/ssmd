+def _tagged_annotation_attrs(attrs: Mapping[str, str], tag: str) -> dict[str, str]:
+    tagged = _annotated_attrs_to_tagged(dict(attrs))
+    if "tag" not in tagged:
+        tagged["tag"] = tag
+    return tagged
